  "instructions_to_main_agent": {
    "tech_stack": [
      "React Native",
      "Expo",
      "react-native-svg (for the donuts)",
      "react-native-reanimated (for animations)",
      "lucide-react-native (for icons, strokeWidth 1.5)"
    ],
    "styling_rules": [
      "DO NOT USE Tailwind CSS. Use React Native StyleSheet.",
      "Use explicit layout: flexDirection, alignItems, justifyContent.",
      "Use 24px screen padding on all main views to maintain breathing room.",
      "Card elements must have a very subtle border (rgba 255,255,255, 0.03) to lift them off the deep background.",
      "Never use pure black (#000000) for backgrounds. Stick to the #0B0E14 scale."
    ],
    "component_instructions": [
      "Energy Donuts: Use react-native-svg <Circle>. Calculate circumference = 2 * Math.PI * radius. Use strokeDasharray and strokeDashoffset. Animate strokeDashoffset with react-native-reanimated.",
      "Templates: Create pill-shaped horizontal scrolling lists or bento-grid blocks for tasks like 'Marche', 'Sieste', 'Travail profond'.",
      "Event Creation Modal: Should feel soft. No jarring full-screen takeovers. Consider a highly rounded bottom sheet.",
      "Smart Suggestions: Style them as 'Glass' cards. They are gentle nudges, not alerts.",
      "Fatigue Score: Visualize softly without alarming colors. Moderate/High should not use harsh red, but rather soft burnt orange or muted purple."
    ],
    "accessibility_and_testing": [
      "All interactive elements (TouchableOpacity, TextInput) MUST have testID prop mirroring data-testid convention (e.g. testID='create-event-button').",
      "Ensure color contrasts meet accessibility standards even in dark mode."
    ]
  }
